# ── Servidor ─────────────────────────────────────────────────
PORT=3333

# ── Autenticação ──────────────────────────────────────────────
# Use uma string longa e aleatória — nunca exponha em produção
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres

# ── Banco de Dados (PostgreSQL) ───────────────────────────────
# Local:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=ecommerce
DB_SSL=false

# Supabase/Vercel:
# Para deploy serverless na Vercel, prefira a string exata do painel:
# Supabase -> Connect -> Transaction pooler.
# DATABASE_URL=postgresql://...
# SUPABASE_DIRECT_DATABASE_URL=postgresql://...
# DB_SSL=true
# DB_POOL_MAX=1

# Supabase Storage:
PRODUCT_STORAGE_PROVIDER=local
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
SUPABASE_PRODUCTS_BUCKET=product-images

# Railway (substitua pelos valores gerados):
# DB_HOST=roundhouse.proxy.rlwy.net
# DB_PORT=12345
# DB_USER=postgres
# DB_PASSWORD=senha_gerada_pelo_railway
# DB_NAME=railway
# DB_SSL=true

# ── Mercado Pago ──────────────────────────────────────────────
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_SANDBOX
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_SANDBOX

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://26.36.11.61:3000
# Produção: FRONTEND_URL=https://seu-app.vercel.app
