# ── Servidor ─────────────────────────────────────────────────
PORT=3333

# ── Autenticação ──────────────────────────────────────────────
# Use uma string longa e aleatória — nunca exponha em produção
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres

# ── Banco de Dados (MySQL) ────────────────────────────────────
# Local:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=ecommerce
DB_SSL=false

# Railway (substitua pelos valores gerados):
# DB_HOST=roundhouse.proxy.rlwy.net
# DB_PORT=12345
# DB_USER=root
# DB_PASSWORD=senha_gerada_pelo_railway
# DB_NAME=railway
# DB_SSL=true

# ── Mercado Pago ──────────────────────────────────────────────
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_SANDBOX
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_SANDBOX

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Produção: FRONTEND_URL=https://seu-app.vercel.app
