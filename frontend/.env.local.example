# URLs internas dos backends (sem barra no final).
# O Next encaminha identity, catálogo e pedidos para Java; pagamentos e demais módulos ficam no Node.
# Local: deixe NEXT_PUBLIC_API_URL sem definir para o navegador usar /api pelo Next.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3333
BACKEND_INTERNAL_URL=http://127.0.0.1:3333
IDENTITY_BACKEND_INTERNAL_URL=http://127.0.0.1:8080
CATALOG_BACKEND_INTERNAL_URL=http://127.0.0.1:8080
ORDERS_BACKEND_INTERNAL_URL=http://127.0.0.1:8080
# Producao: substitua pela URL real apos o deploy.
# NEXT_PUBLIC_API_URL=https://sua-api.vercel.app
