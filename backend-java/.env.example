# Local Spring Boot configuration. Do not commit a real .env file.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
JWT_SECRET=change-this-development-secret-with-32-bytes-minimum
JWT_EXPIRATION=PT8H
JWT_ISSUER=fabrinmarket-api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRODUCT_UPLOAD_DIR=./uploads/products
PRODUCT_STORAGE_PROVIDER=local
# Para usar o adapter remoto, troque para supabase e preencha as três variáveis abaixo.
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
SUPABASE_PRODUCTS_BUCKET=product-images
