# ─────────────────────────────────────────────
# Fabrin E-commerce — Backend (Node/Express/TS)
# ─────────────────────────────────────────────

# O Railway injeta PORT automaticamente — não mexa nessa linha
PORT=${PORT}

# ── JWT ───────────────────────────────────────
JWT_SECRET=${JWT_SECRET}

# ── Banco de Dados (PostgreSQL via Railway) ────────
# O Railway injeta essas vars automaticamente quando você
# adiciona um plugin PostgreSQL ao projeto. Não precisa preencher aqui.
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_USER=${PGUSER}
DB_PASSWORD=${PGPASSWORD}
DB_NAME=${PGDATABASE}
DB_SSL=false

# ── Mercado Pago ──────────────────────────────
MP_ACCESS_TOKEN=${MP_ACCESS_TOKEN}
MP_PUBLIC_KEY=${MP_PUBLIC_KEY}

# ── CORS ──────────────────────────────────────
# Cole aqui a URL do seu frontend na Vercel após o deploy
FRONTEND_URL=https://fabrin-e-commerce-production.up.railway.app
